# Example placeholders. Replace hostnames, suffix, and mount paths before startup.
POXEY_SHELL_HOSTNAME=shell.example.com
POXEY_ARCADE_HOSTNAME=arcade.example.net
POXEY_CONTENT_SUFFIX=replace-with-your-exclusive-recognized-suffix
POXEY_TLS_CERT_FILE=/absolute/private/path/fullchain.pem
POXEY_TLS_KEY_FILE=/absolute/private/path/tls.key
POXEY_ACCESS_TOKEN_FILE=/absolute/private/path/access-token
POXEY_BIND_ADDRESS=127.0.0.1
POXEY_HTTPS_PORT=443
